<%- include('../partials/header') %>

<section class="page-heading">
    <h1>Add a New Movie</h1>
    <p>Enter the information for the movie you want to add.</p>
</section>

<form action="/admin/movies/add" method="POST" class="auth-form">

    <label>Movie Title</label>
    <input type="text" name="title" required>

    <label>Description</label>
    <textarea name="description" required></textarea>

    <label>Release Year</label>
    <input type="number" name="releaseYear" min="1888" required>

    <label>Rating</label>
    <input type="number" name="rating" min="0" max="10" step="0.1" required>

    <label>Poster URL (optional)</label>
    <input type="text" name="poster">

    <label>Genre</label>
    <select name="genreId" required>
        <% genres.forEach(genre => { %>
            <option value="<%= genre.id %>"><%= genre.name %></option>
        <% }) %>
    </select>

    <button type="submit" class="btn">Add Movie</button>

</form>

<a href="/admin">Back to Dashboard</a>

<%- include('../partials/footer') %>