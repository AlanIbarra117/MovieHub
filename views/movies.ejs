<%- include('partials/header') %>

<section class="movies-section">
    <h1>Explore Movies</h1>
    <p>Discover movies from different genres.</p>

    <form action="/movies" method="GET" class="filter-form">

    <input
        type="text"
        name="search"
        placeholder="Search movies by title..."
        value="<%= searchTerm %>"
    >

    <select name="genre">
        <option value="">All Genres</option>

        <% genres.forEach(genre => { %>
            <option
                value="<%= genre.id %>"
                <%= String(selectedGenre) === String(genre.id) ? 'selected' : '' %>
            >
                <%= genre.name %>
            </option>
        <% }) %>
    </select>

    <button type="submit" class="btn">Search</button>

    <a href="/movies" class="btn">Clear Filters</a>

</form>

    <div class="movie-grid">
        <% movies.forEach(movie => { %>
            <% const genre = genres.find(g => g.id === movie.genreId); %>

            <div class="movie-card">
                <div class="movie-info">
                    <h2><%= movie.title %></h2>

                    <p><%= movie.description %></p>

                    <p>Release Year: <%= movie.releaseYear %></p>

                    <p>Genre: <%= genre ? genre.name : 'Unknown' %></p>

                    <p>Rating: <%= movie.rating %>/10</p>
                    <form action="/watchlist/add/<%= movie.id %>" method="POST">
                    <button type="submit" class="btn">
                     Add to Watchlist
                </button>
            </form>
            <a href="/movies/<%= movie.id %>/reviews" class="btn">
                 View Reviews
            </a>
                </div>
            </div>

        <% }) %>
    </div>
</section>

<%- include('partials/footer') %>
